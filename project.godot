; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="vox vacui"
run/main_scene="uid://m2oqym1qilyn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="uid://dernurpysipe2"

[autoload]

Globals="*res://autoloads/globals.gd"
EventBus="*res://autoloads/event_bus.gd"
SFXManager="*res://autoloads/sfx_manager.gd"
LevelTransition="*res://autoloads/level_transition.tscn"
PowerUps="*res://autoloads/power_ups.gd"
ControllerVibration="*res://autoloads/controller_vibration.gd"
SpaceshipEventBus="*res://autoloads/spaceship_event_bus.gd"
PopUpSystem="*res://scenes/spaceship/ui/pop_up_control.tscn"
StatsManager="*res://autoloads/stats_manager.gd"
CustomTooltip="*res://autoloads/custom_tooltip.tscn"
InputGuide="*res://autoloads/input_guide.tscn"
DiaryDatabase="*res://autoloads/diary_database.gd"
HandsEventBus="*res://autoloads/hands_event_bus.gd"
MusicManager="*res://autoloads/music_manager.tscn"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"
PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"

[display]

window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://cmlx2ppg3l6lj"

[dotnet]

project/assembly_name="rogue-space"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/godot_ai/plugin.cfg", "res://addons/phantom_camera/plugin.cfg")

[gdunit4]

settings/test/test_lookup_folder="tests"

[global_group]

Player_Group=""
Boss_Group=""

[gui]

theme/custom="uid://npl3mumy4crf"

